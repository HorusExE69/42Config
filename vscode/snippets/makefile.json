{
	// 42 VS Code config — snippet Makefile (indentation = tabulations, obligatoire)

	"42 Makefile": {
		"prefix": "make42",
		"body": [
			"NAME\t\t= ${1:program}",
			"",
			"CC\t\t\t= cc",
			"CFLAGS\t\t= -Wall -Wextra -Werror",
			"",
			"SRCS\t\t= ${2:main.c}",
			"OBJS\t\t= \\$(SRCS:.c=.o)",
			"",
			"all: \\$(NAME)",
			"",
			"\\$(NAME): \\$(OBJS)",
			"\t\\$(CC) \\$(CFLAGS) \\$(OBJS) -o \\$(NAME)",
			"",
			"%.o: %.c",
			"\t\\$(CC) \\$(CFLAGS) -c \\$< -o \\$@",
			"",
			"clean:",
			"\trm -f \\$(OBJS)",
			"",
			"fclean: clean",
			"\trm -f \\$(NAME)",
			"",
			"re: fclean all",
			"",
			".PHONY: all clean fclean re",
			"$0"
		],
		"description": "Makefile 42 (all, clean, fclean, re, sans relink)"
	}
}
